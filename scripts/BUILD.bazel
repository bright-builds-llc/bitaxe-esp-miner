load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")

package(default_visibility = ["//visibility:private"])

exports_files([
    "build-identity-pathspecs.txt",
    "build_identity.bzl",
    "verify-rollback-probe-isolation.sh",
])

# Terminal Phase 28.1.1 and dormant external-UART/late-attach artifacts are
# intentionally inert. They remain available as immutable historical software,
# but no active Bazel command or test executes them.
filegroup(
    name = "terminal_phase28_uart_artifacts",
    srcs = glob([
        "diagnose-ultra205-late-attach*",
        "diagnose-ultra205-uart-capture*",
        "phase13-monitor-capture.sh",
        "phase13-os-native-reader.pl",
        "phase13-uart-native-reader.py",
        "phase28.1.1*",
        "process-group.sh",
        "serial-session-trace.sh",
        "ultra205-late-attach*",
        "ultra205-transport-qualification*",
        "ultra205-uart-capture*",
    ]),
)

js_library(
    name = "repository_guard_sources",
    srcs = glob(["*.sh", "*.mjs", "*.js", "*.py"], allow_empty = True),
    visibility = ["//tools/automation:__pkg__"],
)

js_test(
    name = "verify_bwg_fixture_exports_test",
    args = [
        "$(rootpath @bwg_gate_contract//:package_json_js)",
        "$(rootpath @bwg_gate_contract//:controller_v03_fixtures_js)",
        "$(rootpath @bwg_gate_contract//:worker_usb_v02_fixtures_js)",
        "$(rootpath @bwg_gate_contract//:worker_possession_fixtures_js)",
        "$(rootpath @bwg_gate_contract//:worker_deployment_trust_fixtures_js)",
        "$(rootpath @bwg_gate_contract//:worker_deployment_trust_js)",
        "$(rootpath @bwg_gate_contract//:ultra205_signed_capability_js)",
        "$(rootpath //firmware/bitaxe:bwg_deployment_trust_js)",
        "$(rootpath //firmware/bitaxe:bwg_ultra205_capability_js)",
    ],
    chdir = ".",
    data = [
        "@bwg_gate_contract//:package_json_js",
        "@bwg_gate_contract//:controller_v03_fixtures_js",
        "@bwg_gate_contract//:worker_usb_v02_fixtures_js",
        "@bwg_gate_contract//:worker_possession_fixtures_js",
        "@bwg_gate_contract//:worker_deployment_trust_fixtures_js",
        "@bwg_gate_contract//:worker_deployment_trust_js",
        "@bwg_gate_contract//:ultra205_signed_capability_js",
        "//firmware/bitaxe:bwg_deployment_trust_js",
        "//firmware/bitaxe:bwg_ultra205_capability_js",
    ],
    entry_point = "verify-bwg-fixture-exports.mjs",
)

js_binary(
    name = "api_command_effects_stratum_pool",
    chdir = ".",
    entry_point = "api-command-effects-stratum-pool.mjs",
    visibility = ["//tools/automation:__pkg__"],
)

js_test(
    name = "api_command_effects_stratum_pool_test",
    chdir = "..",
    data = ["api-command-effects-stratum-pool.mjs"],
    entry_point = "api-command-effects-stratum-pool-test.mjs",
)
