load("//scripts:build_identity.bzl", "build_provenance")
load("@rules_rust//rust:defs.bzl", "rust_test")

exports_files([
    "BUILD.bazel",
    "partitions-ultra205.csv",
    "sdkconfig.defaults",
    "static/recovery_page.html",
    "static/www/index.html",
    "static/www/assets/provenance.js",
    "static/www/assets/release.json",
])

filegroup(
    name = "build_provenance_inputs",
    srcs = [
        "//:firmware_root_build_inputs",
        "//crates/bitaxe-api:bitaxe_api",
        "//crates/bitaxe-asic:bitaxe_asic",
        "//crates/bitaxe-config:bitaxe_config",
        "//crates/bitaxe-core:bitaxe_core",
        "//crates/bitaxe-safety:bitaxe_safety",
        "//crates/bitaxe-stratum:bitaxe_stratum",
        "//scripts:build_identity_status",
    ] + glob([
        "src/**/*.rs",
        "static/**",
    ]) + [
        "BUILD.bazel",
        "Cargo.toml",
        "build.rs",
        "partitions-ultra205.csv",
        "sdkconfig.defaults",
    ],
)

build_provenance(
    name = "_build_provenance",
    srcs = [":build_provenance_inputs"],
)

filegroup(
    name = "build_provenance_stamp",
    srcs = [":_build_provenance"],
    output_group = "stamp",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "build_identity_sdkconfig_defaults",
    srcs = [":_build_provenance"],
    output_group = "sdkconfig_defaults",
)

filegroup(
    name = "build_timestamp_utc",
    srcs = [":_build_provenance"],
    output_group = "build_timestamp_utc",
)

filegroup(
    name = "phase34_identity_sources",
    srcs = [
        "//crates/bitaxe-api:phase34_identity_sources",
        "//crates/bitaxe-core:phase34_identity_sources",
        "build.rs",
        "src/boot_evidence.rs",
        "src/http_api.rs",
        "src/http_api/handlers.rs",
        "src/http_api/websocket.rs",
        "src/log_buffer.rs",
        "src/main.rs",
        "src/operator_snapshot_retention.rs",
        "src/platform_identity.rs",
        "src/runtime_health_adapter.rs",
        "src/runtime_snapshot.rs",
        "src/safety_adapter/watchdog.rs",
        "src/websocket_api.rs",
    ],
    visibility = ["//tools/parity:__pkg__"],
)

filegroup(
    name = "phase35_websocket_sources",
    srcs = ["src/http_api/websocket.rs"],
    visibility = ["//scripts:__pkg__"],
)

test_suite(
    name = "runtime_health_tests",
    tests = [
        "//crates/bitaxe-api:tests",
        "//crates/bitaxe-core:tests",
        "//tools/parity:tests",
    ],
)

alias(
    name = "runtime_health_no_effects_test",
    actual = "//tools/parity:tests",
)

test_suite(
    name = "operator_snapshot_publication_tests",
    tests = [
        "//crates/bitaxe-api:tests",
        "//tools/parity:tests",
    ],
)

rust_test(
    name = "supervisor_checkpoint_production_tests",
    srcs = ["src/safety_adapter/watchdog.rs"],
    crate_name = "supervisor_checkpoint_production_tests",
    edition = "2021",
    deps = [
        "//crates/bitaxe-core:bitaxe_core",
        "//crates/bitaxe-safety:bitaxe_safety",
        "@crates//:log",
    ],
)

rust_test(
    name = "display_adapter_tests",
    srcs = [
        "src/display_adapter.rs",
        "src/display_adapter_host_test.rs",
    ],
    crate_name = "display_adapter_tests",
    crate_root = "src/display_adapter_host_test.rs",
    edition = "2021",
    deps = [
        "//crates/bitaxe-core:bitaxe_core",
        "@crates//:anyhow",
        "@crates//:embedded-graphics",
        "@crates//:embedded-hal",
        "@crates//:log",
        "@crates//:ssd1306",
    ],
)

rust_test(
    name = "retained_pair_production_tests",
    srcs = [
        "src/log_buffer.rs",
        "src/operator_snapshot_retention.rs",
        "src/operator_snapshot_retention_production_tests.rs",
    ],
    crate_name = "retained_pair_production_tests",
    crate_root = "src/operator_snapshot_retention_production_tests.rs",
    edition = "2021",
    deps = [
        "//crates/bitaxe-api:bitaxe_api",
        "@crates//:log",
    ],
)

genrule(
    name = "firmware_build",
    # Cargo dependency: bitaxe-safety is wired in Cargo.toml and compiled by
    # //scripts:build_firmware.
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/http_api.rs",
            "src/http_api/*.rs",
        ],
    ) + [
        ":build_identity_sdkconfig_defaults",
        ":build_provenance_inputs",
        ":build_provenance_stamp",
        ":build_timestamp_utc",
        "Cargo.toml",
        "build.rs",
        "partitions-ultra205.csv",
        "sdkconfig.defaults",
        "src/http_api.rs",
        "src/http_api/access.rs",
        "src/http_api/deferred_effects.rs",
        "src/http_api/handlers.rs",
        "src/http_api/response.rs",
        "src/http_api/settings.rs",
        "src/http_api/updates.rs",
        "src/http_api/websocket.rs",
    ] + glob(["static/**"]),
    outs = [
        "bitaxe-firmware-bootloader.bin",
        "bitaxe-firmware-otadata-initial.bin",
        "bitaxe-firmware-partition-table.bin",
        "bitaxe-firmware.elf",
        "bitaxe-firmware.sdkconfig",
    ],
    cmd = "$(location //scripts:build_firmware) $(@D) $(location :build_provenance_stamp) $(location :build_identity_sdkconfig_defaults) $(location :build_timestamp_utc)",
    local = True,
    tags = [
        "local",
        "no-sandbox",
    ],
    tools = ["//scripts:build_firmware"],
)

filegroup(
    name = "firmware",
    srcs = [":bitaxe-firmware.elf"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "firmware_image",
    srcs = [
        ":bitaxe-firmware-bootloader.bin",
        ":bitaxe-firmware-otadata-initial.bin",
        ":bitaxe-firmware-partition-table.bin",
        ":bitaxe-firmware.elf",
        ":bitaxe-firmware.sdkconfig",
        ":build_provenance_stamp",
    ],
    outs = [
        "bitaxe-ultra205.elf",
        "esp-miner.bin",
        "www.bin",
        "otadata-initial.bin",
        "bitaxe-ultra205-factory.bin",
        "bitaxe-ultra205-package.json",
    ],
    cmd = "$(location //scripts:package_firmware) --reference-guard $(location //scripts:verify_reference_clean) --firmware-elf $(location :bitaxe-firmware.elf) --build-provenance-stamp $(location :build_provenance_stamp) --esp-idf-sdkconfig $(location :bitaxe-firmware.sdkconfig) --bootloader-bin $(location :bitaxe-firmware-bootloader.bin) --partition-table-bin $(location :bitaxe-firmware-partition-table.bin) --otadata-initial-bin $(location :bitaxe-firmware-otadata-initial.bin) --out-dir $(@D) --manifest $(@D)/bitaxe-ultra205-package.json",
    local = True,
    tags = [
        "local",
        "no-sandbox",
    ],
    tools = [
        "//scripts:package_firmware",
        "//scripts:verify_reference_clean",
    ],
    visibility = ["//visibility:public"],
)
