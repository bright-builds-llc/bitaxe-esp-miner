CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
# USB-Serial/JTAG runs on the BBPLL, which a CPU or USB-core reset does not reset. Startup BBPLL
# recalibration powers the PLL down after any reset that left the CPU on it, which can wedge an active
# host link until a USB replug (docs/hardware/known-issues.md). The packaged bootloader is v5.5.4,
# and IDF says to disable this for bootloaders built with v5.2 or later.
CONFIG_ESP_SYSTEM_BBPLL_RECALIB=n
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Rust DWARF enables DEBUG=true in esp-idf-sys; retain the original IDF -O2 policy.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
# Match upstream protocol coordinator and Stratum task priority.
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../firmware/bitaxe/partitions-ultra205.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Ordinary allocations prefer PSRAM at every size; explicit internal/DMA caps (task stacks, FreeRTOS
# objects, DMA, mbedTLS) remain authoritative. A 2 KiB cutoff kept ~1,000 small Rust allocations and
# their periodic churn in internal RAM, leaving under 2 KiB free blocks at idle (heap-loss diagnosis).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# ESP-IDF 5.5.4 Wi-Fi memory-saving buffer profile; see docs/hardware/fixed-usb-memory-profile.md.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIFFS_OBJ_NAME_LEN=64
# Reference: reference/esp-miner/main/Kconfig.projbuild GPIO_ASIC_RESET default.
CONFIG_GPIO_ASIC_RESET=1
# Reference: reference/esp-miner/main/Kconfig.projbuild GPIO_ASIC_ENABLE default.
CONFIG_GPIO_ASIC_ENABLE=10

# Development postmortems stay in flash; never mix raw dumps with controller bytes.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
# Keep task stacks/registers and explicitly selected diagnostic sections; omit heap walking.
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=n
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_STACK_SIZE=4096
CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=n
# Diagnostic: fault at the exact instruction that writes into the last 32 bytes of any task stack.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
