load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "http_transport",
    srcs = [
        "src/lib.rs",
        "src/cadence.rs",
        "src/cadence/input.rs",
        "src/cadence/tests.rs",
        "src/commands.rs",
        "src/observation.rs",
        "src/recovery.rs",
        "src/tests.rs",
        "src/websocket.rs",
    ],
    crate_name = "bitaxe_http_transport",
    edition = "2021",
    deps = [
        "@crates//:anyhow",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:zeroize",
        "@crates//:rustls",
        "@crates//:sha2",
        "@crates//:tungstenite",
        "@crates//:webpki-roots",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":http_transport",
)

rust_binary(
    name = "cadence_observer",
    srcs = ["src/bin/cadence-observer.rs"],
    crate_name = "cadence_observer",
    edition = "2021",
    deps = [":http_transport"],
    visibility = ["//visibility:public"],
)
