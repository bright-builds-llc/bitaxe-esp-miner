load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@aspect_rules_js//js:defs.bzl", "js_library")

filegroup(
    name = "phase36_runtime_identity_sources",
    srcs = [
        "src/model.rs",
        "src/model/state.rs",
    ],
    visibility = ["//tools/parity:__pkg__"],
)

js_library(
    name = "command_effects_budget_sources",
    srcs = [
        "src/usb.rs",
        "src/usb/observation.rs",
        "src/usb/process.rs",
        "src/usb/recovery.rs",
    ],
    visibility = ["//tools/automation:__pkg__"],
)

rust_library(
    name = "device_session_lib",
    srcs = [
        "src/evidence.rs",
        "src/fixture.rs",
        "src/lib.rs",
        "src/live.rs",
        "src/live/session.rs",
        "src/macos.rs",
        "src/macos_unsupported.rs",
        "src/model.rs",
        "src/model/state.rs",
        "src/model/tests.rs",
        "src/platform.rs",
        "src/usb.rs",
        "src/usb/lease.rs",
        "src/usb/line_admission.rs",
        "src/usb/lifecycle.rs",
        "src/usb/observation.rs",
        "src/usb/policy.rs",
        "src/usb/process.rs",
        "src/usb/process/tests.rs",
        "src/usb/recovery.rs",
        "src/usb/tests.rs",
    ],
    crate_name = "bitaxe_device_session",
    edition = "2021",
    deps = [
        "@crates//:anyhow",
        "@crates//:camino",
        "@crates//:libc",
        "//tools/http-transport:http_transport",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "device-session",
    srcs = ["src/main.rs"],
    crate_name = "bitaxe_device_session_cli",
    edition = "2021",
    deps = [
        ":device_session_lib",
        "@crates//:anyhow",
        "@crates//:camino",
        "@crates//:clap",
        "@crates//:serde_json",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":device_session_lib",
    deps = ["@crates//:tempfile"],
)
