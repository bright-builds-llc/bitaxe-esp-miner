load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm__at_types_node__24.13.3__links//:defs.bzl", npm_link_types_node = "npm_link_imported_package")
load("@npm__undici_types__7.18.0__links//:defs.bzl", npm_link_undici_types = "npm_link_imported_package")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "automation_sources",
    srcs = glob(["src/**/*.ts", "src/**/*.swift"]),
)

filegroup(
    name = "macos_provisioning_association_helper",
    srcs = ["src/macos-provisioning-associate.swift"],
)

npm_link_types_node()
npm_link_undici_types()

genrule(
    name = "contracts_verified",
    srcs = ["src/contracts.generated.ts"],
    outs = ["contracts-verified.stamp"],
    cmd = "$(location //crates/bitaxe-automation-contracts:verify_typescript) $(location src/contracts.generated.ts) $@",
    tools = ["//crates/bitaxe-automation-contracts:verify_typescript"],
)

ts_project(
    name = "automation_ts",
    data = [
        ":contracts_verified",
        "package.json",
        "tsconfig.json",
    ],
    srcs = glob(["src/**/*.ts"], exclude = ["src/**/*.test.ts"]),
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/undici-types",
    ],
)

js_binary(
    name = "bitaxe_automation",
    chdir = "../../../..",
    data = [
        ":automation_ts",
        ":macos_provisioning_association_helper",
        "//crates/bitaxe-automation-contracts:validate_version_evidence",
        "//crates/bitaxe-automation-contracts:validate_operator_snapshot_evidence",
        "//crates/bitaxe-automation-contracts:validate_runtime_health_evidence",
        "//crates/bitaxe-automation-contracts:validate_system_info_evidence",
        "//crates/bitaxe-automation-contracts:validate_ultra205_defaults_evidence",
        "//crates/bitaxe-automation-contracts:validate_settings_patch_evidence",
        "//crates/bitaxe-automation-contracts:validate_log_buffer_evidence",
        "//crates/bitaxe-automation-contracts:validate_partition_layout_evidence",
        "//crates/bitaxe-automation-contracts:validate_sdkconfig_rollback_evidence",
        "//crates/bitaxe-automation-contracts:validate_network_reconnect_evidence",
        "//crates/bitaxe-automation-contracts:validate_network_scan_evidence",
        "//crates/bitaxe-automation-contracts:validate_provisioning_network_evidence",
        "//crates/bitaxe-api:system_info_field_contract_js",
        "//crates/bitaxe-config:ultra205_defaults_fixture_js",
        "//tools/flash:flash",
        "//tools/device-session:device-session",
        "//tools/parity:report",
        "//tools/xtask:xtask",
    ],
    entry_point = "dist/cli.js",
)

[
    js_binary(
        name = target,
        args = [command],
        chdir = "../../../..",
        data = [
            ":automation_ts",
            ":macos_provisioning_association_helper",
            "//crates/bitaxe-automation-contracts:validate_version_evidence",
            "//crates/bitaxe-automation-contracts:validate_operator_snapshot_evidence",
            "//crates/bitaxe-automation-contracts:validate_runtime_health_evidence",
            "//crates/bitaxe-automation-contracts:validate_system_info_evidence",
            "//crates/bitaxe-automation-contracts:validate_ultra205_defaults_evidence",
            "//crates/bitaxe-automation-contracts:validate_settings_patch_evidence",
            "//crates/bitaxe-automation-contracts:validate_log_buffer_evidence",
            "//crates/bitaxe-automation-contracts:validate_partition_layout_evidence",
            "//crates/bitaxe-automation-contracts:validate_sdkconfig_rollback_evidence",
            "//crates/bitaxe-automation-contracts:validate_network_reconnect_evidence",
            "//crates/bitaxe-automation-contracts:validate_network_scan_evidence",
            "//crates/bitaxe-automation-contracts:validate_provisioning_network_evidence",
            "//crates/bitaxe-api:system_info_field_contract_js",
            "//crates/bitaxe-config:ultra205_defaults_fixture_js",
            "//tools/flash:flash",
            "//tools/device-session:device-session",
            "//tools/parity:report",
            "//tools/xtask:xtask",
        ],
        entry_point = "dist/cli.js",
    )
    for target, command in {
        "doctor": "doctor",
        "bootstrap_esp": "bootstrap-esp",
        "build_firmware": "build-firmware",
        "package_firmware": "package-firmware",
        "package_rollback_probe": "package-rollback-probe",
        "verify_reference": "verify-reference",
        "verify_redaction": "verify-redaction",
        "verify_production_session": "verify-production-session",
        "observe_serial": "observe-serial",
        "verify_flash_durability": "verify-flash-durability",
        "verify_firmware_ota": "verify-firmware-ota",
        "verify_web_assets_ota": "verify-web-assets-ota",
        "verify_recovery": "verify-recovery",
        "verify_http_api": "verify-http-api",
        "verify_hardware_surface": "verify-hardware-surface",
        "verify_mining": "verify-mining",
        "capture_operator_evidence": "capture-operator-evidence",
        "verify_settings_durability": "verify-settings-durability",
        "verify_theme_durability": "verify-theme-durability",
        "capture_correlated_runtime_evidence": "capture-correlated-runtime-evidence",
        "capture_version_evidence": "capture-version-evidence",
        "capture_operator_snapshot_evidence": "capture-operator-snapshot-evidence",
        "capture_runtime_health_evidence": "capture-runtime-health-evidence",
        "capture_system_info_evidence": "capture-system-info-evidence",
        "capture_ultra205_defaults_evidence": "capture-ultra205-defaults-evidence",
        "capture_settings_patch_evidence": "capture-settings-patch-evidence",
        "capture_log_buffer_evidence": "capture-log-buffer-evidence",
        "capture_partition_layout_evidence": "capture-partition-layout-evidence",
        "capture_sdkconfig_rollback_evidence": "capture-sdkconfig-rollback-evidence",
        "capture_network_reconnect_evidence": "capture-network-reconnect-evidence",
        "capture_network_scan_evidence": "capture-network-scan-evidence",
        "capture_provisioning_network_evidence": "capture-provisioning-network-evidence",
    }.items()
]

ts_project(
    name = "automation_tests_ts",
    data = [
        "package.json",
        "tsconfig.json",
    ],
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    out_dir = "test-dist",
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.test.json",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/undici-types",
    ],
)

js_test(
    name = "automation_test",
    chdir = "../../../..",
    data = [
        ":automation_ts",
        ":automation_tests_ts",
        ":automation_sources",
        ":macos_provisioning_association_helper",
        "//:automation_ci_contract_inputs",
        "//scripts:repository_guard_sources",
        "//firmware/bitaxe:static_provenance_assets",
        "//firmware/bitaxe:ultra205_partition_table",
        "//crates/bitaxe-api:system_info_field_contract_js",
        "//crates/bitaxe-config:ultra205_defaults_fixture_js",
        "//tools/parity:report",
    ],
    entry_point = "test-dist/all.test.js",
)
