load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

js_library(
    name = "adc_observation_sources",
    srcs = ["src/core_voltage_acquisition.rs"],
    visibility = ["//tools/automation:__pkg__"],
)

js_library(
    name = "emc2101_thermal_sources",
    srcs = [
        "src/sensor_acquisition/emc2101.rs",
        "src/thermal.rs",
        "src/thermal_fault_stimulus.rs",
        "src/thermal/pid.rs",
    ],
    visibility = ["//tools/automation:__pkg__"],
)

js_library(
    name = "hashrate_safety_sources",
    srcs = ["src/power.rs"],
    visibility = ["//tools/automation:__pkg__"],
)

rust_library(
    name = "bitaxe_safety",
    srcs = [
        "src/core_voltage_acquisition.rs",
        "src/effects.rs",
        "src/evidence.rs",
        "src/fault.rs",
        "src/lib.rs",
        "src/mining_preconditions.rs",
        "src/observation.rs",
        "src/power.rs",
        "src/power/tests.rs",
        "src/sensor_acquisition.rs",
        "src/sensor_acquisition/emc2101.rs",
        "src/sensor_acquisition/completeness_tests.rs",
        "src/self_test.rs",
        "src/status.rs",
        "src/thermal.rs",
        "src/thermal_fault_stimulus.rs",
        "src/thermal/pid.rs",
        "src/thermal/tests.rs",
        "src/watchdog.rs",
    ],
    compile_data = glob(["fixtures/**"], allow_empty = True),
    crate_name = "bitaxe_safety",
    edition = "2021",
    deps = [
        "//crates/bitaxe-config:bitaxe_config",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":bitaxe_safety",
    compile_data = glob(["fixtures/**"], allow_empty = True),
    deps = [
        "@crates//:serde_json",
    ],
)
