load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

filegroup(
    name = "architecture_model_sources",
    srcs = ["src/confirmed_snapshot.rs"],
    visibility = ["//tools/parity:__pkg__"],
)

rust_library(
    name = "bitaxe_config",
    srcs = [
        "src/catalog.rs",
        "src/confirmed_snapshot.rs",
        "src/defaults.rs",
        "src/defaults/matrix.rs",
        "src/defaults/matrix/tests.rs",
        "src/display.rs",
        "src/golden_tests.rs",
        "src/lib.rs",
        "src/nvs.rs",
        "src/nvs/loading.rs",
        "src/nvs/migration.rs",
        "src/nvs/schema.rs",
        "src/nvs/schema/controls.rs",
        "src/nvs/schema/fallback_stratum.rs",
        "src/nvs/schema/legacy.rs",
        "src/nvs/schema/misc.rs",
        "src/nvs/schema/network.rs",
        "src/nvs/schema/platform.rs",
        "src/nvs/schema/primary_stratum.rs",
        "src/nvs/schema/selftest.rs",
        "src/nvs/schema/sensors.rs",
        "src/nvs/tests.rs",
        "src/nvs/types.rs",
        "src/persistence.rs",
        "src/settings.rs",
        "src/settings/tests.rs",
        "src/validation.rs",
        "src/validation/tests.rs",
    ],
    compile_data = glob(["fixtures/**"]),
    crate_name = "bitaxe_config",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/bitaxe-core:bitaxe_core",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "tests",
    crate = ":bitaxe_config",
    data = glob(["fixtures/**"]),
    deps = [
        "@crates//:csv",
        "@crates//:serde_json",
    ],
)
