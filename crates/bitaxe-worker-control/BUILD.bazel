load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "bitaxe_worker_control",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bitaxe_worker_control",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:base64",
        "@crates//:curve25519-dalek",
        "@crates//:ed25519-dalek",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:zeroize",
    ],
)

rust_test(
    name = "authorization_tests",
    srcs = ["tests/authorization.rs"],
    crate_name = "bitaxe_worker_control_authorization_tests",
    edition = "2021",
    deps = [
        ":bitaxe_worker_control",
        "@crates//:base64",
        "@crates//:curve25519-dalek",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "controller_tests",
    srcs = ["tests/controller.rs", "tests/controller/liveness.rs"],
    crate_root = "tests/controller.rs",
    crate_name = "bitaxe_worker_control_controller_tests",
    edition = "2021",
    deps = [
        ":bitaxe_worker_control",
        "@crates//:base64",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "identity_store_tests",
    srcs = ["tests/identity_store.rs"],
    crate_name = "bitaxe_worker_control_identity_store_tests",
    edition = "2021",
    deps = [":bitaxe_worker_control"],
)

rust_test(
    name = "firmware_config_tests",
    srcs = ["tests/firmware_config.rs"],
    compile_data = [
        "//firmware/bitaxe:bwg/deployment-trust.json",
        "//firmware/bitaxe:bwg/ultra205-capability.json",
    ],
    crate_name = "bitaxe_worker_firmware_config_tests",
    edition = "2021",
    deps = [":bitaxe_worker_control", "@crates//:base64", "@crates//:ed25519-dalek", "@crates//:serde_json"],
)

rust_test(
    name = "framing_tests",
    srcs = ["tests/framing.rs"],
    crate_name = "bitaxe_worker_control_framing_tests",
    edition = "2021",
    deps = [":bitaxe_worker_control", "@crates//:serde_json"],
)

rust_test(
    name = "effect_marker_tests",
    srcs = ["tests/effect_marker.rs"],
    crate_name = "bitaxe_worker_control_effect_marker_tests",
    edition = "2021",
    deps = [":bitaxe_worker_control"],
)

rust_test(
    name = "possession_tests",
    srcs = ["tests/possession.rs"],
    crate_name = "bitaxe_worker_control_possession_tests",
    edition = "2021",
    deps = [
        ":bitaxe_worker_control",
        "@crates//:base64",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "reboot_restoration_tests",
    srcs = ["tests/reboot_restoration.rs"],
    crate_name = "bitaxe_worker_control_reboot_restoration_tests",
    edition = "2021",
    deps = [
        ":bitaxe_worker_control",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "gate_conformance_tests",
    srcs = ["tests/gate_conformance.rs"],
    crate_name = "bitaxe_worker_control_gate_conformance_tests",
    data = [
        "@bwg_gate_contract//:controller_v04_fixtures",
        "@bwg_gate_contract//:worker_serial_v01_fixtures",
        "@bwg_gate_contract//:worker_possession_fixtures",
        "@bwg_gate_contract//:worker_deployment_trust_fixtures",
    ],
    edition = "2021",
    env = {
        "BWG_SERIAL_FIXTURES": "$(rootpath @bwg_gate_contract//:worker_serial_v01_fixtures)",
        "BWG_DEPLOYMENT_FIXTURES": "$(rootpath @bwg_gate_contract//:worker_deployment_trust_fixtures)",
        "BWG_POSSESSION_FIXTURES": "$(rootpath @bwg_gate_contract//:worker_possession_fixtures)",
    },
    deps = [
        ":bitaxe_worker_control",
        "//crates/bitaxe-core:bitaxe_core",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "preservation_tests",
    srcs = ["tests/preservation.rs"],
    crate_name = "bitaxe_worker_preservation_tests",
    edition = "2021",
    deps = [":bitaxe_worker_control", "@crates//:serde_json"],
)
